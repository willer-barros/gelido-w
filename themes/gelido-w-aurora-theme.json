{
  "name": "gelido-w-aurora",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#00e5ff",
    "class": { "foreground": "#5fd4ff", "bold": true },
    "interface": "#5fd4ff",
    "parameter": { "foreground": "#9fd3e6", "italic": true }
  },
  "colors": {
