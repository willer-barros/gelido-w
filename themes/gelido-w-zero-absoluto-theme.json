    "gitDecoration.untrackedResourceForeground": "#b66bff"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#4f7088", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#00f0ff", "fontStyle": "bold" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#00e0c3" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#b66bff" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#7ff5e4" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": { "foreground": "#b8f2ff", "fontStyle": "bold" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#e6fffb" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#9fd3e6", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#8aa4c0" }
    },
    {
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#5f8aa6" }
    },
    {
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#00f0ff" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#7ff5e4", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.decorator", "meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#b66bff" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#00f0ff", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#00e0c3" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff4d6d" }
    }
  ]
}