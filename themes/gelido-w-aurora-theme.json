    "gitDecoration.modifiedResourceForeground": "#00e5ff",
    "gitDecoration.addedResourceForeground": "#4dffb4",
    "gitDecoration.deletedResourceForeground": "#ff5c7a",
    "gitDecoration.untrackedResourceForeground": "#b794ff"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5b7790", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#b794ff" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#4dffb4" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#ff7ad9" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#00e5ff" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": { "foreground": "#5fd4ff", "fontStyle": "bold" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#e6fffb" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#9fd3e6", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#8aa4c0" }
    },
    {
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#6f8fa8" }
    },
    {
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#b794ff" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#4dffb4", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.decorator", "meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#ff7ad9" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#4dffb4", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#4dffb4" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff5c7a" }
    }
  ]
}