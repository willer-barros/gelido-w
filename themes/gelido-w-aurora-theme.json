    "terminal.ansiBlack": "#061520",
    "terminal.ansiRed": "#ff5c7a",
    "terminal.ansiGreen": "#4dffb4",
    "terminal.ansiYellow": "#ffc266",
    "terminal.ansiBlue": "#5fa8ff",
    "terminal.ansiMagenta": "#b794ff",
    "terminal.ansiCyan": "#00e5ff",
    "terminal.ansiWhite": "#e6fffb",
    "terminal.ansiBrightBlack": "#3a506b",
    "terminal.ansiBrightRed": "#ff8aa0",
    "terminal.ansiBrightGreen": "#8dffd0",
    "terminal.ansiBrightYellow": "#ffd99a",
    "terminal.ansiBrightBlue": "#8cc3ff",
